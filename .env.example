# RouterAI (основной провайдер LLM/медиа)
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://api.routerai.example/v1

# OpenRouter (резервный LLM-провайдер)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# fal.ai (резерв для медиа-генерации)
FAL_API_KEY=

# Опционально: личный Telegram-бот (вариант B, uv run telegram-bot)
TELEGRAM_BOT_TOKEN=
# Твой личный chat_id — бот отвечает только этому chat_id. Оставь пустым при
# первом запуске: бот залогирует chat_id первого написавшего в консоль,
# перенеси его сюда и перезапусти.
TELEGRAM_CHAT_ID=
